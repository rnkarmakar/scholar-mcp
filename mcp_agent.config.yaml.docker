# yaml-language-server: $schema=https://raw.githubusercontent.com/lastmile-ai/mcp-agent/refs/heads/main/schema/mcp-agent.config.schema.json

execution_engine: asyncio

logger:
  transports: [console]
  level: debug

mcp:
  servers:
    arxiv-mcp-server:
      command: uvx
      args:
        - arxiv-mcp-server
    scholar:
      command: uv
      args:
        - run
        - tool.py

openai:
  default_model: gpt-4.1
